# Public address of the site, with no trailing slash. Used for canonical links, the sitemap
# and social previews. Leave empty until a domain is connected; Vercel's own URL is used meanwhile.
# Example: https://www.example.com
NEXT_PUBLIC_SITE_URL=

# Optional: overrides the built-in Google "write a review" link shown in the contact section.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
